{
  "expo": {
    "name": "Suhoor",
    "slug": "suhoor",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mechseiko.suhoor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-nobg.png",
        "backgroundColor": "#F29F1D"
      }
    },
    "web": {
      "bundler": "metro",
      "headers": {
        "Content-Security-Policy": "default-src 'self' localhost:* ws://localhost:* 'unsafe-inline' 'unsafe-eval'; connect-src *; img-src * data: blob:; media-src *; font-src *;"
      }
    },
    "jsEngine": "hermes",
    "extra": {
      "eas": {
        "projectId": "85eb894d-aa4f-42e8-9763-2b366cc16bd2"
      }
    }
  }
}
