\u0631 \u0633\u0628 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0641\u062a \u06c1\u06d2\u06d4 \u06c1\u0645\u0627\u0631\u0627 \u0645\u0634\u0646 \u0633\u0628 \u06a9\u0648 \u0633\u06c1\u0648\u0631 \u06a9\u06be\u0627\u0646\u06d2\u060c \u0627\u0646 \u06a9\u06d2 \u0631\u0648\u0632\u06d2 \u0679\u0631\u06cc\u06a9 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0633\u062a\u0648\u06ba \u0627\u0648\u0631 \u062e\u0627\u0646\u062f\u0627\u0646\u0648\u06ba \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0631\u0627\u0628\u0637\u06d2 \u0645\u06cc\u06ba \u0631\u06c1\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u06a9\u0631\u0646\u0627 \u06c1\u06d2\u06d4","faq.groups":"\u06af\u0631\u0648\u067e\u0633 \u06a9\u06cc\u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u061f","faq.groupsAnswer":"\u0622\u067e \u0645\u0646\u0641\u0631\u062f \u06a9\u0648\u0688 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2 \u0627\u06cc\u06a9 \u06af\u0631\u0648\u067e \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 \u0628\u0646\u0627\u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u062f\u0648\u0633\u062a\u0648\u06ba \u06cc\u0627 \u062e\u0627\u0646\u062f\u0627\u0646\u0648\u06ba \u06a9\u0648 \u0645\u062f\u0639\u0648 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u062c\u0628 \u0648\u06c1 \u0634\u0627\u0645\u0644 \u06c1\u0648\u06ba \u06af\u06d2\u060c \u062a\u0648 \u0622\u067e \u0627\u06cc\u06a9 \u062f\u0648\u0633\u0631\u06d2 \u06a9\u0648 \u0633\u06c1\u0648\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062c\u06af\u0627 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4","faq.mobileApp":"\u06a9\u06cc\u0627 \u0645\u0648\u0628\u0627\u0626\u0644 \u0627\u06cc\u067e \u06c1\u06d2\u061f","faq.mobileAppAnswer":"\u0645\u0648\u0628\u0627\u0626\u0644 \u0627\u06cc\u067e \u0627\u0628\u06be\u06cc \u062a\u06cc\u0627\u0631 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2\u06d4","faq.accuracy":"\u0631\u0648\u0632\u06c1 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a \u06a9\u062a\u0646\u06cc \u062f\u0631\u0633\u062a \u06c1\u06cc\u06ba\u061f","faq.accuracyAnswer":"\u06c1\u0645 \u0622\u067e \u06a9\u06d2 \u0645\u0642\u0627\u0645 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u0627\u0639\u0644\u06cc \u062f\u0631\u062c\u06d2 \u06a9\u06cc \u062f\u0631\u0633\u062a \u0631\u0648\u0632\u06c1 \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0622\u067e \u0627\u067e\u0646\u06d2 \u0645\u0642\u0627\u0645\u06cc \u0645\u0633\u062c\u062f \u0633\u06d2 \u0645\u06cc\u0644 \u06a9\u06be\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06d2 \u0633\u06cc\u0679\u0646\u06af\u0632 \u0645\u06cc\u06ba \u0631\u0648\u0632\u06c1 \u06a9\u06d2 \u0627\u0648\u0642\u0627\u062a \u0628\u06be\u06cc \u0627\u06cc\u0688\u062c\u0633\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4","faq.privacy":"\u06a9\u06cc\u0627 \u0645\u06cc\u0631\u0627 \u0645\u0642\u0627\u0645 \u0688\u06cc\u0679\u0627 \u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0679 \u06c1\u06d2\u061f","faq.privacyAnswer":"\u0622\u067e \u06a9\u06cc \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062f\u06c1 \u0645\u0642\u0627\u0645 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a (\u062c\u06cc\u0633\u06d2 \u067e\u062a\u06c1\u060c \u06c1\u0627\u0633\u0679\u0644 \u06a9\u0627 \u0646\u0627\u0645) \u0635\u0631\u0641 \u0622\u067e \u06a9\u06d2 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u062f\u06c1 \u06af\u0631\u0648\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u0648\u0631 \u0635\u0631\u0641 \u0622\u067e \u06a9\u06d2 \u062c\u0627\u06af\u0646\u06d2 \u06a9\u06cc \u0648\u0646\u0688\u0648 \u06a9\u06d2 \u062f\u0648\u0631\u0627\u0646 \u0634\u06cc\u0626\u0631 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4","faq.voluntary":"\u06a9\u06cc\u0627 \u0645\u06cc\u06ba \u0633\u06c1\u06