u0645\u062c\u0645\u0648\u0639\u062a\u0643","howitworks.step":"\u0627\u0644\u062e\u0637\u0648\u0629","cta.jumpBack":"\u0639\u062f \u0641\u0648\u0631\u0627\u064b!","cta.ready":"\u0647\u0644 \u0623\u0646\u062a \u0645\u0633\u062a\u0639\u062f \u0644\u0644\u0628\u062f\u0621\u061f","cta.pickUp":"\u062a\u0627\u0628\u0639 \u0645\u0646 \u062d\u064a\u062b \u062a\u0648\u0642\u0641\u062a","cta.joinMuslims":"\u0627\u0646\u0636\u0645 \u0625\u0644\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 100 \u0645\u0633\u0644\u0645 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0633\u062d\u0648\u0631 \u0628\u0627\u0644\u0641\u0639\u0644","faq.title":"\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629","faq.subtitle":"\u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0644\u0645\u0639\u0631\u0641\u062a\u0647 \u0639\u0646 \u0628\u062f\u0621 \u0631\u062d\u0644\u062a\u0643 \u0645\u0639 \u0627\u0644\u0633\u062d\u0648\u0631.","faq.free":"\u0647\u0644 \u0627\u0644\u0633\u062d\u0648\u0631 \u0645\u062c\u0627\u0646\u064a \u062a\u0645\u0627\u0645\u0627\u064b \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u061f","faq.freeAnswer":"\u0646\u0639\u0645! \u0627\u0644\u0633\u062d\u0648\u0631 \u0645\u062c\u0627\u0646\u064a \u0644\u0644\u062c\u0645\u064a\u0639. \u0645\u0647\u0645\u062a\u0646\u0627 \u0647\u064a \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u062c\u0645\u064a\u0639 \u0639\u0644\u0649 \u062a\u0646\u0627\u0648\u0644 \u0627\u0644\u0633\u062d\u0648\u0631\u060c \u0648\u062a\u062a\u0628\u0639 \u0635\u064a\u0627\u0645\u0647\u0645 \u0648\u0627\u0644\u0628\u0642\u0627\u0621 \u0639\u0644\u0649 \u0627\u062a\u0635\u0627\u0644 \u0645\u0639 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621 \u0648\u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a.","faq.groups":"\u0643\u064a\u0641 \u062a\u0639\u0645\u0644 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a\u061f","faq.groupsAnswer":"\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0623\u0648 \u0625\u0646\u0634\u0627\u0621 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u062f\u0639\u0648\u0629 \u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621 \u0623\u0648 \u0627\u0644\u0639\u0627\u0626\u0644\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0631\u0645\u0632 \u0641\u0631\u064a\u062f. \u0628\u0645\u062c\u0631\u062f \u0627\u0646\u0636\u0645\u0627\u0645\u0647\u0645\u060c \u064a\u0645\u0643\u0646\u0643 \u0625\u064a\u0642\u0627\u0638 \u0628\u0639\u0636\u0643\u0645 \u0627\u0644\u0628\u0639\u0636 \u0644\u0644\u0633\u062d\u0648\u0631.","faq.mobileApp":"\u0647\u0644 \u0647\u0646\u0627\u0643 \u062a\u0637\u0628\u064a\u0642 \u062c\u0648\u0627\u0644\u061f","faq.mobileAppAnswer":"\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062c\u0648\u0627\u0644 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0642\u064a\u062f \u0627\u0644\u062a\u0637\u0648\u064a\u0631.","faq.accuracy":"\u0645\u0627 \u0645\u062f\u0649 \u062f\u0642\u0629 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u064a\u0627\u0645\u061f","faq.accuracyAnswer":"\u0646\u0633\u062a\u062e\u062f\u0645 \u0623\u0648\u0642\u0627\u062a \u0635\u064a\u0627\u0645 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062f\u0642\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0643. \u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u0627\u064b \u0636\u0628\u0637 \u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0635\u064a\u0627\u0645 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0643 \u0644\u062a\u0637\u0627\u0628\u0642 \u0645\u0633\u062c\u062f\u0643 \u0627\u0644\u0645\u062d\u0644\u064a.","faq.privacy":"\u0647\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0648\u0642\u0639\u064a \u062e\u0627\u0635\u0629\u061f","faq.privacyAnswer":"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0648\u0642\u0639\u0643 \u0627\u0644\u062a\u064a \u062a\u0642\u062f\u0645\u0647\u0627 (\u0645\u062b\u0644 \u0627\u0644\u0639\u0646\u0648\u0627\u0646\u060c \u0627\u0633\u0645 \u0627\u0644\u0646\u0632\u0644) \u064a\u062a\u0645 \u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0627 \u0641\u0642\u0637 \u062f\u0627\u062e\u0644 \u0645\u062c\u0645\u0648\u0639\u062a\u0643 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0648\u0641\u0642\u0637 \u062e\u0644\u0627\u0644 \u0646\u0627\u0641\u0630\u0629 \u0627\u0633\u062a\u064a\u0642\u0627\u0638\u0643.","faq.voluntary":"\u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u062d\u0648\u0631 \u0644\u0644\u0635\u064a\u0627\u0645 \u0627\u0644\u062a\u0637\u0648\u0639\u064a\u061f","faq.voluntaryAnswer":"\u0628\u0627\u0644\u0637\u0628\u0639! \u0627\u0644\u0633\u062d\u0648\u0631 \u0645\u0635\u0645\u0645 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u0644\u0649 \u0645\u062f\u0627\u0631 \u0627\u0644\u0639\u0627\u0645 \u0644\u0635\u064a\u0627\u0645 \u0627\u0644\u0633\u0646\u0629 (\u0645\u062b\u0644 \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u0648\u0627\u0644\u062e\u0645\u064a\u0633) \u0623\u0648 \u0623\u064a \u0635\u064a\u0627\u0645 \u062a\u0637\u0648\u0639\u064a \u0622\u062e\u0631.","alarm.wakeUp":"\u0627\u0633\u062a\u064a\u0642\u0638!","alarm.timeForSuhoor":"\u062d\u0627\u0646 \u0648\u0642\u062a \u0627\u0644\u0633\u062d\u0648\u0631","alarm.iAmAwake":"\u0623\u0646\u0627 \u0645\u0633\u062a\u064a\u0642\u0638","alarm.confirmTitle":"\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u064a\u0642\u0627\u0638","alarm.confirmSub":"\u0633\u064a\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0648\u0642\u062a \u0627\u0633\u062a\u064a\u0642\u0627\u0638\u0643 \u0641\u064a \u0645\u062c\u0645\u0648\u0639\u062a\u0643.","alarm.confirm":"\u062a\u0623\u0643\u064a\u062f","alarm.verifyTitle":"\u062a\u0623\u0643\u064a\u062f \u0623\u0646\u0643 \u0645\u0633\u062a\u064a\u0642\u0638","alarm.verifySub":"\u0627\u0643\u062a\u0628 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645 \u0644\u062a\u062b\u0628\u062a \u0623\u0646\u0643 \u0645\u0633\u062a\u064a\u0642\u0