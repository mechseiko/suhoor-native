e":"Create","common.loading":"Loading...","common.error":"Error","common.success":"Success","common.back":"Back","common.next":"Next","common.search":"Search","common.filter":"Filter","common.viewAll":"View All","common.showMore":"Show More","common.showLess":"Show Less","common.and":"and","common.or":"or","common.verified":"Verified","common.notVerified":"Not Verified","common.openMenu":"Open menu","common.closeMenu":"Close menu","common.searchShortcut":"Ctrl K","terms.title":"Terms of Service","terms.lastUpdated":"Last updated","privacy.title":"Privacy Policy","privacy.lastUpdated":"Last updated","dashboard.title":"Dashboard","dashboard.welcome":"Welcome back","dashboard.welcomeNew":"Welcome to Suhoor","dashboard.stats":"Statistics","dashboard.totalGroups":"Total Groups","dashboard.totalMembers":"Total Members","dashboard.daysFasted":"Days Fasted","dashboard.fastingHistory":"Fasting History","dashboard.activity":"Activity","dashboard.groupsCreated":"Groups Created","dashboard.fastingDays":"Fasting Days","dashboard.blessing":"May your fasts be accepted and your prayers answered.","dashboard.journeyBegins":"Your Journey Begins!","dashboard.welcomeText":"We're so glad to have you with us. You can start by","dashboard.downloadApp":"Downloading the app","dashboard.createGroup":"creating a group","dashboard.readBooks":"reading books of knowledge","dashboard.groups":"Groups","dashboard.groupsJoined":"Groups joined","dashboard.acrossGroups":"Across all groups","dashboard.thisYear":"This year","dashboard.fastingConsistency":"Your fasting consistency over time","dashboard.recalculating":"Recalculating","dashboard.data":"Data","home.welcomeMorning":"Good Morning \ud83c\udf05","home.welcomeAfternoon":"Good Afternoon \u2600\ufe0f","home.welcomeEvening":"Good Evening \ud83c\udf19","home.dashboardStats":"Dashboard Stats","home.totalGroups":"Total Groups","home.joinedGroupsSub":"Joined groups","home.totalMembers":"Total Members","home.acrossGroupsSub":"Across groups","home.fastingDays":"Fasting Days","home.completedThisYearSub":"Completed this year","home.fastingHistory":"Fasting History","home.consistencySub":"Consistency over the past 7 days","home.legendFasted":"Fasted","home.legendSkipped":"Skipped / No Record","footer.quickLinks":"Quick Links","footer.community":"Community","footer.sponsor":"Sponsor","footer.contact":"Contact","footer.whatsapp":"WhatsApp","footer.developer":"Developer","footer.builtWith":"Built with","footer.forUmmah":"for the Ummah","footer.allRights":"All Rights Reserved","features.title":"Everything Suhoor. In one App","features.subtitle":"Designed to help you make the most of your fasting period","features.communityCircles":"Community Circles","features.communityCirclesDesc":"Form spiritual circles with friends and family. Share the blessings of Suhoor through a unified platform.","features.wakeUpCalls":"Wake Up Calls","features.wakeUpCallsDesc":"Ensure no one misses the meal. Send and receive real time notifications to wake your group members.","features.fastingTimes":"Fasting Times","features.fastingTimesDesc":"Accurate timings for Suhoor and Iftar, complete with Hijri dates and Sunnah fasting reminders.","features.resources":"Resources","features.resourcesDesc":"Explore a curated collection of essential Islamic duas and books on fasting.","howitworks.title":"How It Works","howitworks.subtitle":"Get started in minutes and you'll never miss Suhoor again. If Allah wishes.","howitworks.createGroups":"Create Groups","howitworks.createGroupsDesc":"Create a group or join one with friends and family","howitworks.setWakeTimes":"Set Wake Times","howitworks.setWakeTimesDesc":"Everyone gets notified when it's time for Suhoor","howitworks.stayConnected":"Stay Connected","howitworks.stayConnectedDesc":"See who's awake and wake those that are not","howitworks.trackProgress":"Track Progress","howitworks.trackProgressDesc":"Monitor your group's consistency","howitworks.step":"Step","cta.jumpBack":"Jump right Back In!","cta.ready":"Ready to Get Started?","cta.pickUp":"Pick up right where you left off","cta.joinMuslims":"Join 100+ Muslims already using Suhoor","faq.title":"Frequently Asked Questions","faq.subtitle":"Everything you need to know about starting your journey with Suhoor.","faq.free":"Is Suhoor completely free to use?","faq.freeAnswer":"Yes! Suhoor is free for all. Our mission is to help everyone eat suhoor, track their fasts and stay connected with friends and families.","faq.groups":"How do the groups work?","faq.groupsAnswer":"You can join or create a group and invite friends or family using a unique code. Once they join, you can wake each other up for suhoor.","faq.mobileApp":"Is there a mobile app?","faq.mobileAppAnswer":"The mobile app is still being developed.","faq.accuracy":"How accurate are the fasting times?","faq.accuracyAnswer":"We use high precision fasting times based on your location. You can also adjust the fasting times in your settings to match your local mosque.","faq.privacy":"Is my location data private?","faq.privacyAnswer":"Your location is only used to fetch accurate fasting times from our API. It is not shared with your group or used for any other purpose.","faq.voluntary":"Can I use Suhoor for voluntary fasts?","faq.voluntaryAnswer":"Of course! Suhoor is designed to be used year round for Sunnah fasts (like Mondays and Thursdays) or any other voluntary fasting.","alarm.wakeUp":"WAKE UP!","alarm.timeForSuhoor":"Time for Suhoor","alarm.iAmAwake":"I AM AWAKE","alarm.confirmTitle":"Confirm Wake-Up","alarm.confirmSub":"Your wake-up time will be logged to your group.","alarm.confirm":"Confirm","alarm.verifyTitle":"Verify You're Awake","alarm.verifySub":"Type today's date to prove you're awake and alert","alarm.verifyInstruction":"To confirm you are awake and alert, type today's date in full ({{pattern}}).","alarm.verifyButton":"Verify","alarm.formatHint":"Format: {{pattern}}","alarm.exampleHint":"Example: {{example}}","alarm.dateError":"Incorrect date. Please try again.","alarm.dateFormatError":"Incorrect date. Please type today's date in this format: {{pattern}}.","alarm.successTitle":"Verified!","alarm.successSub":"You're marked as awake in your group.","alarm.notificationTitle":"WAKE UP! Time for Suhoor","alarm.notificationBody":"Your group is counting on you. Tap to confirm you're awake.","audioMode.warningTitle":"Audio Mode Warning","audioMode.warningMessage":"Your phone may be in silent or Do Not Disturb mode. Alarms may not sound properly.","audioMode.openSettings":"Open Settings","email.verifySubject":"Suhoor - Verify Your Email","email.verifyTitle":"Verify Your Email Address","email.verifyIntro":"Welcome to Suhoor! Kindly verify your email address to complete your registration.","email.verifyButton":"Verify My Email","email.verifyNote":"If you did not create this account, please ignore this email.","duas.title":"Duas & Adhkar","duas.subtitle":"Supplications from the Sunnah","duas.benefits":"Benefits:","duas.source":"Source:","duas.empty":"No duas available","duas.loadError":"Could not load duas. Please try again.","duas.fallbackNotice":"Duas aren't available in {{language}} yet \u2014 showing {{fallback}}.","fastingTimes.loading":"Loading fasting times...","fastingTimes.loadError":"Failed to load fasting times","fastingTimes.hijriDate":"Hijri Date","fastingTimes.hijriToday":"Today is {{day}} {{month}} {{year}} AH","fastingTimes.gregorianDate":"Gregorian Date","fastingTimes.suhoorEnds":"Suhoor Ends","fastingTimes.iftarBegins":"Iftar Begins","fastingTimes.wakeUpTimes":"Wake Up Times","fastingTimes.defaultWakeUp":"Default Wake Up","fastingTimes.defaultWakeUpSub":"{{minutes}} minutes before the end of Suhoor","fastingTimes.personalWakeUp":"Personal Wake Up","fastingTimes.personalWakeUpSub":"Configure your own wake up time","fastingTimes.allowedRange":"Allowed: {{min}}-{{max}} minutes before Suhoor ends","fastingTimes.minutesBeforeSuhoor":"minutes before Suhoor","fastingTimes.calculated":"Calculated: {{time}}","fast