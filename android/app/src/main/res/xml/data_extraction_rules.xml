<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up and nothing is migrated.

  Why: a reinstall must behave like a fresh install. With allowBackup="true"
  Android Auto Backup was restoring the app's AsyncStorage database, which holds
  both the Firebase session and the 'suhoor-onboarding-complete' flag. The
  result was a user who uninstalled the app, reinstalled it from Play, and
  landed straight back inside the app signed in — never seeing onboarding again,
  even if they had signed out before uninstalling (the restored copy is a
  snapshot taken before the sign-out).

  android:allowBackup="false" disables cloud backup and restore, but since
  Android 12 device-to-device transfer is controlled separately by this file,
  so the same domains are excluded there. The user's real data lives in
  Firestore against their account; nothing of value is device-only except the
  alarm PIN and cached prefs, which are cheap to set again after signing in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
