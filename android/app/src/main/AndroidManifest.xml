<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <!--
    Optional, because nothing here needs Wi-Fi hardware. ACCESS_WIFI_STATE is
    merged in by @react-native-community/netinfo (it uses it for SSID/BSSID,
    which this app never reads), and Google Play turns that permission into an
    implied android.hardware.wifi REQUIREMENT. Declaring it explicitly as
    not-required overrides the implied filter, so the app stays installable on
    devices without a Wi-Fi radio. Cellular connectivity detection is
    unaffected.
  -->
  <uses-feature android:name="android.hardware.wifi" android:required="false"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/AppTheme" android:exported="true" android:showWhenLocked="true" android:turnScreenOn="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- Deep Link Intent Filter for custom scheme (suhoor://) -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="suhoor"/>
      </intent-filter>
      <!-- Android App Links Intent Filter for verified web domain -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="suhoor-group.web.app"/>
      </intent-filter>
    </activity>

    <!--
      Alarm Activity.

      - showWhenLocked/turnScreenOn are the real framework attributes
        (android:showOnLockScreen, which used to be here, is not one — it was
        silently ignored; the code sets the same flags at runtime).
      - exported="false": it is only ever started by our own PendingIntents and
        by our own receiver, both of which run with this app's identity. The old
        exported="true" plus a MAIN/DEFAULT intent-filter let any installed app
        pop a full-screen alarm over the lock screen.
      - singleInstance + excludeFromRecents: an alarm screen must not stack when
        two alarms fire close together, and must not linger in Recents.
    -->
    <activity
      android:name=".alarm.AlarmActivity"
      android:exported="false"
      android:launchMode="singleInstance"
      android:excludeFromRecents="true"
      android:showWhenLocked="true"
      android:turnScreenOn="true" />

    <!--
      Alarm Receiver. exported="false" on purpose: AlarmManager delivers the
      PendingIntent with this app's own identity, so the alarm still fires, but
      another app can no longer broadcast ALARM_TRIGGER with a crafted payload
      and make the phone scream at full volume over the lock screen.
    -->
    <receiver android:name=".alarm.AlarmReceiver" android:exported="false"/>

    <!-- Boot Receiver: also re-arms alarms after a Play Store update, a clock or
         timezone change, and after the user grants exact-alarm access. -->
    <receiver android:name=".alarm.BootReceiver" android:enabled="true" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
      </intent-filter>
    </receiver>

    <!-- Alarm Foreground Service -->
    <service android:name=".alarm.AlarmForegroundService" android:foregroundServiceType="specialUse" android:exported="false">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Suhoor alarm service for scheduled prayer/meal notifications"/>
    </service>

    <!-- FCM: delivers group buzzes while the app is closed -->
    <service android:name=".push.SuhoorMessagingService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT"/>
      </intent-filter>
    </service>

    <!--
      react-native-push-notification ships an EMPTY library manifest: these two
      receivers have to be declared here or nothing it schedules ever fires.
      Without RNPushNotificationPublisher, AlarmManager holds a PendingIntent to
      an undeclared component and every localNotificationSchedule() is dropped
      silently — the library reports success and posts nothing. This is the
      fallback notification path used when the native alarm engine is
      unavailable; reminders (iftar, check-in) use it too.

      Deliberately NOT declared: RNPushNotificationListenerService. It also
      filters com.google.firebase.MESSAGING_EVENT, and SuhoorMessagingService
      above already handles buzzes natively; a second handler would deliver the
      same FCM message twice.
    -->
    <receiver
      android:name="com.dieam.reactnativepushnotification.modules.RNPushNotificationPublisher"
      android:exported="false"/>
    <receiver
      android:name="com.dieam.reactnativepushnotification.modules.RNPushNotificationBootEventReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
